{
  "name": "morgan-finance",
  "version": "0.1.0",
  "description": "A local-first personal finance workspace for tracking bank accounts, investments, crypto assets, and net worth across private profiles.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.8.1",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.15"
    }
  },
  "scripts": {
    "dev": "next dev",
    "dev:docker": "node scripts/dev/dev-docker.mjs",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate --schema=prisma/schema.prisma",
    "vercel-build": "prisma generate --schema=prisma/schema.prisma && prisma migrate deploy --schema=prisma/schema.prisma && next build",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern .next-* --ignore-pattern next-env.d.ts --ignore-pattern prisma/*.db --ignore-pattern prisma/*.db-journal --ignore-pattern artifacts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "typecheck:test": "tsc --noEmit -p tsconfig.test.json",
    "test": "vitest",
    "test:unit": "vitest run tests/unit",
    "test:scripts": "vitest run scripts",
    "test:run": "vitest run",
    "release:check": "pnpm run prisma:validate && pnpm run lint && pnpm run typecheck && pnpm run typecheck:test && pnpm run test:run && pnpm run build",
    "test:rate-limit:clear": "node scripts/testing/clear-rate-limits.mjs",
    "seed:performance": "node scripts/testing/seed-dashboard-performance-data.mjs",
    "smoke:upload-panel": "node scripts/e2e/smoke-upload-panel.mjs",
    "smoke:upload-panel:docker": "node scripts/e2e/smoke-upload-panel.mjs --base-url=http://127.0.0.1:3001 --no-start-server",
    "e2e:docker:full": "node scripts/e2e/full-browser-flow.mjs",
    "e2e:realistic": "node scripts/e2e/realistic-browser-flow.mjs",
    "e2e:active-components": "node scripts/e2e/active-components-walkthrough.mjs",
    "migrate:binance-secrets:legacy-sqlite": "node scripts/db/migrate-binance-plaintext.legacy-sqlite.mjs",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate:postgres": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate:sqlite": "prisma generate --schema=prisma/sqlite/schema.prisma",
    "prisma:validate": "node scripts/db/validate-prisma-schemas.mjs",
    "db:migrate": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:migrate:postgres": "prisma migrate deploy --schema=prisma/schema.prisma",
    "db:migrate:dev": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:dev:postgres": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:dev:sqlite": "prisma migrate dev --schema=prisma/sqlite/schema.prisma",
    "docker:postgres": "docker compose up -d postgres",
    "docker:postgres:down": "docker compose down",
    "docker:preprod:build": "docker compose build app",
    "docker:preprod:up": "docker compose up -d --build app",
    "docker:preprod:down": "docker compose down",
    "docker:preprod:reset": "docker compose down -v"
  },
  "dependencies": {
    "@prisma/client": "^6.7.0",
    "better-auth": "^1.6.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "node-html-parser": "^7.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.0.10",
    "recharts": "^3.8.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.18",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.6",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "playwright": "^1.60.0",
    "prisma": "^6.7.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
