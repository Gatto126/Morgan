{
  "name": "morgan-finance",
  "version": "0.1.0",
  "description": "A local-first personal finance workspace for tracking bank accounts, investments, crypto assets, and net worth across private profiles.",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.8.1",
  "pnpm": {
    "overrides": {
      "postcss": "8.5.15"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern next-env.d.ts --ignore-pattern prisma/*.db --ignore-pattern prisma/*.db-journal",
    "test": "vitest",
    "test:run": "vitest run",
    "migrate:binance-secrets": "node scripts/migrate-binance-plaintext.mjs",
    "prisma:generate": "prisma generate",
    "db:push": "prisma db push"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^6.7.0",
    "@prisma/client": "^6.7.0",
    "better-auth": "^1.6.11",
    "better-sqlite3": "^11.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.3.2",
    "node-html-parser": "^7.1.0",
    "playwright": "^1.60.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "read-excel-file": "^9.0.10",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.7",
    "@types/node": "^22.15.18",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.6",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fflate": "^0.8.3",
    "prisma": "^6.7.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vitest": "^4.1.7"
  }
}
